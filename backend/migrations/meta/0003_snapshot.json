          "value": "\"concerns\".\"gender_code\" is null or \"concerns\".\"gender_code\" in ('male', 'female', 'non_binary', 'other', 'no_answer')"
        },
        "concerns_visibility_status_check": {
          "name": "concerns_visibility_status_check",
          "value": "\"concerns\".\"visibility_status\" in ('pending', 'published', 'hidden', 'deleted')"
        },
        "concerns_processing_status_check": {
          "name": "concerns_processing_status_check",
          "value": "\"concerns\".\"processing_status\" in ('pending', 'processing', 'ready', 'failed')"
