        "concerns_input_method_check": {
          "name": "concerns_input_method_check",
          "value": "\"concerns\".\"input_method\" in ('liff', 'voice')"
        },
        "concerns_age_group_check": {
          "name": "concerns_age_group_check",
          "value": "\"concerns\".\"age_group\" is null or \"concerns\".\"age_group\" in ('10s', '20s', '30s', '40s', '50s', '60s', '70s', '80s', '90s_plus', 'no_answer')"
