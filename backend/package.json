{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc",
    "dev:vectorize": "wrangler dev --config wrangler.vectorize.dev.jsonc",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "lint": "oxlint",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --config wrangler.dev.jsonc --file ./scripts/dev-seed.sql --yes && wrangler d1 execute DB --local --config wrangler.dev.jsonc --file ./scripts/seed-local-posts.sql --yes",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "vectorize:backfill": "node ./scripts/backfill-vectorize.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.8",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.82.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.131.1"
  }
}
