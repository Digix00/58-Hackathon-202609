{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "lint": "oxlint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
