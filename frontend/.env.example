# backend(Cloudflare Workers)のURL。未設定時はwrangler devの既定ポートを見る。
VITE_API_BASE_URL=http://localhost:8787

# LINE Developers Console で発行した LIFF ID。本番環境で設定する。
VITE_LINE_LIFF_ID=

# ローカルでLINEミニアプリのヘッダー・フッターを確認する場合だけtrueにする。
# 実際のLINEログインやLIFF APIは利用できない。
VITE_DEV_LIFF_MODE=false

# ローカルAPIの開発用認証を使う場合はbackendにする。
# 開発時のみ有効。本番ビルドでは無効になる。
VITE_DEV_AUTH_MODE=

# VITE_DEV_AUTH_MODE=backend のときに使用する固定の開発用ユーザー。
VITE_DEV_USER=demo-a
